# 이 파일을 복사해서 application-secret.properties 로 만들고 값을 채우세요.
#   (application-secret.properties 는 .gitignore 에 등록되어 커밋되지 않습니다.)
# 새 비밀 값(JWT, OAuth 등)이 생기면 여기에도 키를 추가해 팀원이 알 수 있게 합니다.

# Datasource
DATABASE_URL=jdbc:mysql://localhost:3306/your_database
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_password
