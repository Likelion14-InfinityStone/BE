# 이 파일을 복사해서 application-secret.properties 로 만들고 값을 채우세요.
#   (application-secret.properties 는 .gitignore 에 등록되어 커밋되지 않습니다.)
# 새 비밀 값(JWT, OAuth 등)이 생기면 여기에도 키를 추가해 팀원이 알 수 있게 합니다.

# Datasource
DATABASE_URL=jdbc:mysql://localhost:3306/your_database
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_password

# JWT
# 서명 키: openssl rand -base64 64 로 생성 (512비트)
JWT_SECRET=your-512-bit-random-secret
# Access Token 만료 (ms). 예) 86400000 = 1일
JWT_ACCESS_EXPIRATION=86400000
# Refresh Token 만료 (ms). 예) 604800000 = 7일
JWT_REFRESH_EXPIRATION=604800000

# KAKAO
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# CLOVA OCR
CLOVA_OCR_INVOKE_URL=your_clova_ocr_apigw_invoke_url
CLOVA_OCR_SECRET_KEY=your_clova_ocr_secret_key
